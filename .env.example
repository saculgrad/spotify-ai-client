# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Required — from https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Required — Spotify rejects a bare "localhost" redirect, must be exactly this
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Required — from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional — where the cached Spotify OAuth token is stored (default: .spotify_cache)
# SPOTIPY_CACHE_PATH=.spotify_cache

# Optional — signs the flash-message cookie; only matters if this ever runs
# somewhere shared, not on a personal machine (default: a static dev value)
# FLASK_SECRET_KEY=

# Optional — port the Flask dev server listens on (default: 5000)
# PORT=5000
